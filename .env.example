# Public browser configuration. Use only a publishable/anon key, with RLS enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only secrets. NEVER prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional static sub-path build (APIs require Vercel at the origin root).
VITE_BASE=/
